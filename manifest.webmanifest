{
 "name": "Score Snap",
 "short_name": "Score Snap",
 "description": "ถ่ายรูปโน้ตเพลง แล้วฟังและแก้ไขได้ทันที",
 "lang": "th",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#F6F3FE",
 "theme_color": "#7C3AED",
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/vnd.recordare.musicxml+xml": [
     ".musicxml"
    ],
    "application/vnd.recordare.musicxml": [
     ".mxl"
    ]
   }
  }
 ]
}